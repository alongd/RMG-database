################################################################################
#
#   File patterns for git to ignore
#
################################################################################

# MacOS Files
.DS_Store

# Eclipse project files
.project
.pydevproject
.settings/*

# PyCharm project files
.idea/*

# C-Compiled scripts
*.pyc

*.ipynb_checkpoints

# evaluate kinetics folder stuff
testing/eval/*

# local-only agent working files
docs/superpowers/
docs/contracts/

# pytest
.pytest_cache/
__pycache__/
